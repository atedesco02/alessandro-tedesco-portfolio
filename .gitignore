# --- CFD output (keep the repo light; commit setups, not results) ---
*.foam
processor*/
postProcessing/
# OpenFOAM time directories (0.1, 1, 2, 10, 100, ...) — fixed-length digit
# classes only (no trailing wildcard), so this can't accidentally match
# numbered project folders like "01-truck-aerodynamic-devices": those always
# have a hyphen+letters right after the leading digits, which these patterns
# don't allow.
[0-9]/
[0-9][0-9]/
[0-9][0-9][0-9]/
[0-9][0-9][0-9][0-9]/
[0-9].[0-9]*/
[0-9][0-9].[0-9]*/
[0-9][0-9][0-9].[0-9]*/
# but keep the initial-conditions directory
!0/
constant/polyMesh/
VTK/
*.vtk
*.vtu
*.vtp
*.pvd
*.cgns

# --- meshes & large binaries ---
*.msh
*.cgns
*.stl.gz
*.h5
*.hdf5

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# --- MATLAB ---
*.asv
*.mat

# --- CAD junk ---
*.bak
~$*

# --- OS ---
.DS_Store
Thumbs.db
